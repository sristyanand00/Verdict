# Copy to .env.local (never committed) or set in the Vercel project settings.
# Where the Verdict API lives. Leave empty when the backend serves this site itself
# (http://localhost:8000) or in dev (the Vite proxy sends /api to localhost:8000).
# For Vercel: the backend's public address, for example https://verdict-api.example.com
# The backend must list the Vercel address in VERDICT_CORS_ORIGINS.
VITE_API_BASE=
