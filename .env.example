# Copy to .env and adjust. Nothing here is secret; secrets are never committed.

# Where the BIRD corpora live. Unset = <repo>/datasets
# Local (Windows):  C:\verdict-data\datasets
# GPU host:         /mnt/bird
# Container:        /data
VERDICT_DATA_ROOT=

# Where run artifacts are written. Unset = <repo>/results
VERDICT_RESULTS_ROOT=
